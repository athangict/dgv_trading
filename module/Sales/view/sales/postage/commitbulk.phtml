    <script>
        $('input[type=radio][name=cash]').change(function(){
        if ($(this).val() == "0") {
			$('#journal').show();
			 $('#phone').show();
			 $('#party').hide();
			 $('#ref_no').hide();
        } 
		else if($(this).val() == "1"){
			$('#journal').hide();
			 $('#phone').hide();
			 $('#party').hide();
			 $('#ref_no').hide();
			
		}else {
           $('#journal').hide();
			 $('#phone').hide();
			 $('#party').show();
			 $('#ref_no').show();
        } 
    });
    </script>
