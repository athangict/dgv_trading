<script type="text/javascript">
$('document').ready(function(){
    $('#dataTables').DataTable({
        "paging": true,
    });


    $("tr").each(function() {
        var tenderDate = $(this).find("td:nth-child(3)").text(); 
        var bidDate = $(this).find("td:nth-child(6)").text(); 
        var psecurityDate = $(this).find("td:nth-child(8)").text(); 

        
        var tenderDateObj = new Date(tenderDate);
        var bidDateObj = new Date(bidDate);
        var psecurityDateObj = new Date(psecurityDate);

        
        if (bidDateObj > tenderDateObj) {
            $(this).find("td:nth-child(6)").css('background-color', 'red'); 
        } else if (bidDateObj < tenderDateObj) {
            $(this).find("td:nth-child(6)").css('background-color', 'green'); 
        }

        
        if (psecurityDateObj > tenderDateObj) {
            $(this).find("td:nth-child(8)").css('background-color', 'red'); 
        } else if (psecurityDateObj < tenderDateObj) {
            $(this).find("td:nth-child(8)").css('background-color', 'green'); 
        }
    });

   
    $("tr[data-href]").each(function(){
        $(this).find('td').not('td.action').each(function(){
            $(this).css('cursor','pointer');
            $(this).bind('click',function() {
                window.document.location = $(this).closest('tr').attr("data-href");
            });
        });
    });
});

</script>
