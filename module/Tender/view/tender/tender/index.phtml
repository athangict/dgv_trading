<script type="text/javascript">
$('document').ready(function(){
    $('#dataTables').DataTable({
        "paging": true,
    });

    function parseDate(dateStr) {
        // Support dd-mm-yyyy or dd/mm/yyyy
        var parts = dateStr.split(/[-\/]/);
        if (parts.length !== 3) return null;
        return new Date(parts[2], parts[1] - 1, parts[0]); // year, month-1, day
    }

    $("tr").each(function() {
        var tenderDateStr = $(this).find("td:nth-child(3)").text().trim();
        var bidDateStr = $(this).find("td:nth-child(6)").text().trim(); 
        var bidSecurity = $(this).find("td:nth-child(7)").text().trim(); 
        var psecurityDateStr = $(this).find("td:nth-child(8)").text().trim(); 
        var psecurity = $(this).find("td:nth-child(9)").text().trim(); 

        var tenderDate = parseDate(tenderDateStr);
        var bidDate = parseDate(bidDateStr);
        var psecurityDate = parseDate(psecurityDateStr);

        // BID SECURITY COMPARISON
        if (bidSecurity !== "" && bidSecurity !== "0" && bidDate) {
            if (bidDate > tenderDate) {
                $(this).find("td:nth-child(6)").css('background-color', 'red'); 
            } else if (bidDate < tenderDate) {
                $(this).find("td:nth-child(6)").css('background-color', 'green'); 
            }
        }

        // PERFORMANCE SECURITY COMPARISON
        if (psecurity !== "" && psecurity !== "0" && psecurityDate) {
            if (psecurityDate > tenderDate) {
                $(this).find("td:nth-child(8)").css('background-color', 'red'); 
            } else if (psecurityDate < tenderDate) {
                $(this).find("td:nth-child(8)").css('background-color', 'green'); 
            }
        }
    });

    // Optional row click
    $("tr[data-href]").each(function(){
        $(this).find('td').not('td.action').each(function(){
            $(this).css('cursor','pointer');
            $(this).on('click', function() {
                window.document.location = $(this).closest('tr').attr("data-href");
            });
        });
    });
});


</script>
