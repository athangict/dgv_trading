<script type="text/javascript">
$('document').ready(function(){
    $('#start_date').datepicker();
    $('#end_date').datepicker();
    $('#dataTables').DataTable({
        "paging":   true,
    });
    
    // Item selection logic (add your own logic here if needed)
    $('#item_class').on('change', function(){
        $.post(
            "<?php echo $this->url('pos', array('action' => 'getItemgroup')); ?>",
            {
                item_class: $(this).val(),
            },
            function(data){
                console.log(data);
                $("#item_subgroup").html(data.subgroup);    
                $("#item_subgroup").trigger('chosen:updated');
            },
            'json'
        );    
    });

    $('#item_subgroup,#location').on('change', function(){
        $.post(
            "<?php echo $this->url('pos', array('action' => 'getItemChange')); ?>",
            {
                locationId: $("#location").val(),
                item_subgroup: $("#item_subgroup").val(),
            },
            function(data){
                console.log(data);
                $("#item").html(data.items);    
                $("#item").trigger('chosen:updated');
            },
            'json'
        );    
    });

    $('#location').on('change', function(){
        $.post(
            "<?php echo $this->url('pos', array('action' => 'getUsers')); ?>",
            {
                locationId: $("#location").val(),
            },
            function(data){
                console.log(data);
                $("#user").html(data.users);    
                $("#user").trigger('chosen:updated');
            },
            'json'
        );    
    });

    // Calculate totals for tender amounts, bid security, etc.
    var totalAmount = 0;
    var totalBidSecurity = 0;
    var totalPerformanceSecurity = 0;

    $('#dataTables tbody tr').each(function() {
        var amount = parseFloat($(this).find('td').eq(4).text().replace(/[^0-9.-]+/g,"")); // Tender Amount
        var bidSecurity = parseFloat($(this).find('td').eq(7).text().replace(/[^0-9.-]+/g,"")); // Bid Security
        var performanceSecurity = parseFloat($(this).find('td').eq(8).text().replace(/[^0-9.-]+/g,"")); // Performance Security

        totalAmount += isNaN(amount) ? 0 : amount;
        totalBidSecurity += isNaN(bidSecurity) ? 0 : bidSecurity;
        totalPerformanceSecurity += isNaN(performanceSecurity) ? 0 : performanceSecurity;
    });

    $('#dataTables tfoot').html(
        '<tr>' +
            '<td colspan="4"><strong>Total</strong></td>' +
            '<td><strong>' + totalAmount.toFixed(2) + '</strong></td>' +
            '<td></td>' +
            '<td></td>' +
            '<td><strong>' + totalBidSecurity.toFixed(2) + '</strong></td>' +
            '<td><strong>' + totalPerformanceSecurity.toFixed(2) + '</strong></td>' +
            '<td></td>' +
        '</tr>'
    );
});
</script>

