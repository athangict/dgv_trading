<script type="text/javascript">    
$(function() {
    // Toggle amount/number field visibility based on type
    $('#type').on('change', function () {
        var selectedType = $(this).val();

        if (selectedType == 1 || selectedType == 2) {
            $('#number').closest('.form-group').show();
            $('#amount').closest('.form-group').hide();
        } else if (selectedType == 3) {
            $('#amount').closest('.form-group').show();
            $('#number').closest('.form-group').hide();
        } else {
            $('#number').closest('.form-group').hide();
            $('#amount').closest('.form-group').hide();
        }
    });

    // Trigger change on page load to initialize visibility
    $('#type').trigger('change');

    // Handle sub period loading
    $('#period').on('change', function(){
        if($(this).val() == 1 || $(this).val() == 2){
            $('#subp').show();
            $.post(
                "<?php echo $this->url('target', array('action' => 'getsubperiod')); ?>",
                { id: $(this).val() },
                function(data){
                    console.log(data);
                    $("#subperiod").html(data.subperiod);    
                    $("#subperiod").trigger('chosen:updated');
                },
                'json'
            );    
        } else {
            $('#subp').hide();
        }
    });

    // Datepicker (if any fields exist)
    $('#tender_date, #quotation_date').datepicker();

    // Form validation (optional based on your form logic)
    const fv = FormValidation.formValidation(document.getElementById('form'), {
        fields: {
            // Add your field validations here
        },
        plugins: {
            trigger: new FormValidation.plugins.Trigger(),
            bootstrap3: new FormValidation.plugins.Bootstrap3(),
            submitButton: new FormValidation.plugins.SubmitButton(),
            defaultSubmit: new FormValidation.plugins.DefaultSubmit(),
        }
    });
});
</script>
