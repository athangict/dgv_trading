<script type="text/javascript">
var room = 1;
function purchase_field() {
    room++;
    var newRow = `
    <tr class="form-group removeclass${room}">
        <td>
            <select class="form-control tr_prn_no" name="prn_no[]" id="prn_no" required>
                <option value="">Select Option</option>
                <?php foreach ($purreceipt as $pr): ?>
                <option value="<?php echo $pr['id']; ?>"><?php echo $pr['prn_no']; ?></option>
                <?php endforeach; ?>
            </select>
        </td>
        <td >
            <select class="form-control tr_supplier" name="supplier[]" id="supplier" required>
                <option value="">Select Option</option>
            </select>
        </td>
		<td class="d-flex align-items-center">
            <input class="form-control tr_pr_amount" name="pr_amount[]" id="pr_amount" readonly>
            <button type="button" class="btn btn-danger btn-xs remove_row" data-row="${room}" style="margin-left:5px;">
                <i class="fa fa-times"></i>
            </button>
        </td>
    </tr>`;
    $('#purchase_field tbody').append(newRow);
    calculateTotalAmount();
}
$(document).on('change', '.tr_prn_no', function() {
		var selectedItem = $(this).val(); // get the value of the changed .tr_item
		var relatedItemElement = $(this).closest('tr').find('.tr_supplier'); // find the related .tr_supplier in the same row
		var relatedItemElement1 = $(this).closest('tr').find('.tr_pr_amount'); // find the related .tr_pr_amount in the same row
		console.log(selectedItem);
		// Assuming you want to do an AJAX call similar to what you've shown in your initial code:
		$.post(
			"<?php echo $this->url('billing', array('action' => 'getsupplier')); ?>",
			{
				prn_no: selectedItem,
			},
			function(data) {
				relatedItemElement.html(data.supplier); // updating the related .tr_uom
				relatedItemElement.trigger('chosen:updated'); // if you're using chosen plugin
				relatedItemElement1.val(data.sum); // if you're using chosen plugin
				calculateTotalAmount();
				
			},
			'json'
		);  
	});
function calculateTotalAmount() {
		console.log("calculateTotal amount");
		var total = 0.0;

		// Iterate over each amount input field in the table
		$('.tr_pr_amount').each(function() {
			var amount = parseFloat($(this).val());
			if (!isNaN(amount)) { // Make sure it's a valid number
				total += amount;
			}
		});

		// Update the #total field with the new sum
		$('#receipt_amt').val(total.toFixed(2));
		calculateNet();
	}	

function calculateNet() {
	totalNet = 0, totalGross = 0;

	var discount = parseFloat($('#discount').val()) || 0;
	var reciept = parseFloat($('#receipt_amt').val()) || 0;

	var netTotal = reciept - discount;
	$('#net').val(netTotal.toFixed(2));
	calculateTotal();
}

function calculateTotal() {

	var discount = parseFloat($('#discount').val()) || 0;
	var tax = parseFloat($('#tax').val()) || 0;
	var freight = parseFloat($('#freight').val()) || 0;
	var load = parseFloat($('#load_amt').val()) || 0;
	var exp = parseFloat($('#exp').val()) || 0;
	var net = parseFloat($('#net').val()) || 0;

	var grandTotal = net + tax + freight + load + exp;

	$('#total').val(grandTotal.toFixed(2));
}

$(document).ready(function () {
	$('#billing_date').datepicker();
	$('#location').trigger('change');


	$(document).on('click', '.remove_row', function () {
		var rowId = $(this).data('row');
		$('.removeclass' + rowId).remove();
		updatePRNOptions();
		calculateTotal();
	});

	$('#tax, #freight, #load_amt, #exp').on('input', calculateTotal);
	$('#discount').on('input', calculateNet);
});

// supplier total calculation

function calculateTotalWithGST() {

    var receipt = parseFloat($('#receipt_amt').val()) || 0;
    var discount = parseFloat($('#discount').val()) || 0;
    var supplierGST = parseFloat($('#gst_rate').val()) || 0; // user enters GST amount

    // Net calculation
    var net = receipt - discount;
    $('#net').val(net.toFixed(2));

    // Directly set GST amount (no calculation)
    $('#gst_amt').val(supplierGST.toFixed(2));

    // Total = Net + GST
    var total = net + supplierGST;
    $('#row_total').val(total.toFixed(2));
}

// Trigger calculation when discount or gst_rate changes
$('#discount, #gst_rate').on('input', function () {
    calculateTotalWithGST();
});

// FREIGHT TOTAL CALCULATION
function calculateFreightTotal() {

    var freight = parseFloat($('#freight').val()) || 0;
    var freightGST = parseFloat($('#freight_gst').val()) || 0;

    // Total = Amount + GST
    var total = freight + freightGST;

    $('#freight_total').val(total.toFixed(2));
}
$('#freight, #freight_gst').on('input', function () {
    calculateFreightTotal();
});

// TAX TOTAL CALCULATION
function calculateTaxTotal(){

    var tax = parseFloat($('#tax').val()) || 0;
    var taxGST = parseFloat($('#tax_gst').val()) || 0;

    var total = tax + taxGST;

    $('#tax_total').val(total.toFixed(2));
}

$('#tax, #tax_gst').on('input', function () {
    calculateTaxTotal();
});

// LOADING AND UNLOADING TOTAL CALCULATION
function calculateLoadTotal(){

    var loadAMT = parseFloat($('#load_amt').val()) || 0;
    var loadGST = parseFloat($('#load_gst').val()) || 0;

    var total = loadAMT + loadGST;

    $('#load_total').val(total.toFixed(2));
}

$('#load_amt, #load_gst').on('input', function () {
    calculateLoadTotal();
});

// OTHER EXPENSES TOTAL CALCULATION
function calculateOtherExpensesTotal(){

    var exp = parseFloat($('#exp').val()) || 0;
    var expGST = parseFloat($('#exp_gst').val()) || 0;

    var total = exp + expGST;

    $('#exp_total').val(total.toFixed(2));
}

$('#exp, #exp_gst').on('input', function () {
    calculateOtherExpensesTotal();
});

function calculateFinalTotals(){

    // GST values
    var supplierGST = parseFloat($('#gst_rate').val()) || 0;
    var freightGST  = parseFloat($('#freight_gst').val()) || 0;
    var taxGST      = parseFloat($('#tax_gst').val()) || 0;
    var loadGST     = parseFloat($('#load_gst').val()) || 0;
    var expGST      = parseFloat($('#exp_gst').val()) || 0;

    // Calculate GST Total
    var gstTotal = supplierGST + freightGST + taxGST + loadGST + expGST;
    $('#gst_total').val(gstTotal.toFixed(2));


    // Total fields
    var supplierTotal = parseFloat($('#row_total').val()) || 0;
    var freightTotal  = parseFloat($('#freight_total').val()) || 0;
    var taxTotal      = parseFloat($('#tax_total').val()) || 0;
    var loadTotal     = parseFloat($('#load_total').val()) || 0;
    var expTotal      = parseFloat($('#exp_total').val()) || 0;

    // Calculate Grand Total
    var grandTotal = supplierTotal + freightTotal + taxTotal + loadTotal + expTotal;

    $('#grand_total').val(grandTotal.toFixed(2));
}
$('#gst_rate, #freight_gst, #tax_gst, #load_gst, #exp_gst, #freight, #tax, #load_amt, #exp, #discount').on('input', function(){
    calculateFinalTotals();
});
</script>
