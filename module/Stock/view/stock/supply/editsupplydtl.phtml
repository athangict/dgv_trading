<script type="text/javascript">
    var room = 1;

    function supplydtl_field() {
        room++;
        var newRow = `
        <tr class="form-group removeclass${room}">
            <td>
                <select class="form-control tr_item_class" name="item_class[]">
                    <option value="">Select</option>
                    <?php foreach($itemClass as $itemC): ?>
                        <option value="<?php echo $itemC['id'];?>"><?php echo $itemC['item_class'];?></option>
                    <?php endforeach; ?>
                </select>
            </td>
            <td>
                <select class="form-control tr_item" name="item[]">
                    <option value=""></option>
                </select>
            </td>
            <td><input type="text" class="form-control tr_tender_slNo" name="tender_slNo[]" placeholder="Tender Sl.No"></td>
            <td><input type="text" class="form-control tr_batch_no" name="batch_no[]" placeholder="Batch No"></td>
            <td><input type="text" class="form-control tr_mftg_date" name="mftg_date[]" value="<?php echo date('Y-m-d');?>" readonly></td>
            <td><input type="text" class="form-control tr_exp_date" name="exp_date[]" value="<?php echo date('Y-m-d');?>" readonly></td>
            <td><input type="number" class="form-control tr_quantity" name="quantity[]" value="0"></td>
            <td><input type="number" step="0.0001" class="form-control tr_rate" name="rate[]" value="0.00"></td>
            <td><input type="text" class="form-control gst_rate"  name="gst_rate[]" value="0" readonly></td>
            <td><input type="text" class="form-control gst_amt"  name="gst_amt[]" value="0" readonly></td>
            <td><input type="number" step="0.01" class="form-control tr_amount" name="amount[]" value="0.00" readonly></td>
            <td class="d-flex align-items-center">
                <input type="text" class="form-control" name="remarks[]" placeholder="Remarks">
                <button type="button" class="btn btn-danger btn-xs" onclick="remove_supplydtl_field(${room});" style="margin-left:5px;">
                    <i class="fa fa-times"></i>
                </button>
            </td>
        </tr>`;

        $('#supplydtl_field tbody').append(newRow);
        $('.tr_exp_date, .tr_mftg_date').datepicker({ format: 'yyyy-mm-dd', autoclose: true });
        calculateTotalAmount();
        updateGstTotal();
    }

    function remove_supplydtl_field(rid) {
        $('.removeclass' + rid).remove();
        calculateTotalAmount();
        updateGstTotal();
    }

    $('#supply_date').datepicker({ format: 'yyyy-mm-dd', autoclose: true });

    function calculateTotal(element) {
        var row = element.closest('tr');
        var rate = parseFloat(row.find('.tr_rate').val()) || 0;
        var quantity = parseFloat(row.find('.tr_quantity').val()) || 0;
        var gstRate = parseFloat(row.find('.gst_rate').val()) || 0;

        var amount = rate * quantity;
        var gstAmount = (amount * gstRate) / 100;

        row.find('.tr_amount').val(amount.toFixed(2));
        row.find('.gst_amt').val(gstAmount.toFixed(2));

        calculateTotalAmount();
        updateGstTotal();
    }

    $(document).on('input', '.tr_rate, .tr_quantity', function() {
        calculateTotal($(this));
    });

    $(document).on('change', '.tr_item', function () {
        var selectedOption = $(this).find(':selected');
        var gstRate = selectedOption.data('gst') || 0;

        var row = $(this).closest('tr');
        row.find('.gst_rate').val(gstRate);

        calculateTotal(row.find('.tr_rate'));
    });

    $(document).on('change', '.tr_item_class', function() {
        var selectedClass = $(this).val();
        var relatedItemElement = $(this).closest('tr').find('.tr_item');
        $.post(
            "<?php echo $this->url('supply', array('action' => 'getitem')); ?>",
            { itemclassId: selectedClass },
            function(data) {
                relatedItemElement.html(data.item);
                relatedItemElement.trigger('chosen:updated');
            }, 'json'
        );
    });

    function calculateTotalAmount() {
        var total = 0;
        $('.tr_amount').each(function() {
            var amount = parseFloat($(this).val());
            if (!isNaN(amount)) total += amount;
        });
        $('#total').val(total.toFixed(2));
        calculateGrandTotal();
    }

    function updateGstTotal() {
        var totalGst = 0;
        $('.gst_amt').each(function() {
            var gst = parseFloat($(this).val()) || 0;
            totalGst += gst;
        });
        $('#gst_total').val(totalGst.toFixed(2));
        calculateGrandTotal();
    }

    function calculateGrandTotal() {
        var total = parseFloat($('#total').val()) || 0;
        var gstTotal = parseFloat($('#gst_total').val()) || 0;
        $('#grand_total').val((total + gstTotal).toFixed(2));
    }

    $(document).ready(function() {
        $('.tr_exp_date, .tr_mftg_date').datepicker({ format: 'yyyy-mm-dd', autoclose: true });
        $('.tr_rate, .tr_quantity').each(function() { calculateTotal($(this)); });
        calculateTotalAmount();
        updateGstTotal();
    });
</script>